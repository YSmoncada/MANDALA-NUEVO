{
  "expo": {
    "name": "Mandala",
    "slug": "mandala-frontend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mandala",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandala.app"
    },
    "android": {
      "package": "com.mandala.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

